#!/usr/bin/env bash
set -Eeuo pipefail
fail(){ printf 'Installation failed: %s\n' "$*" >&2; exit 1; }
command -v base64 >/dev/null || fail 'base64 is required'
command -v python3 >/dev/null || fail 'python3 is required'
DOCS="$(xdg-user-dir DOCUMENTS 2>/dev/null || true)"
DESKTOP="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
[[ -n "$DOCS" ]] || DOCS="$HOME/Documents"
[[ -n "$DESKTOP" ]] || DESKTOP="$HOME/Desktop"
mkdir -p "$DOCS" "$DESKTOP"
SCRIPT="$DOCS/opera-gx-codec-fix.sh"
LAUNCHER="$DESKTOP/Opera GX Codec Fix.desktop"
if [[ -e "$SCRIPT" ]]; then
  cp -a "$SCRIPT" "${SCRIPT}.pre-installer-backup.$(date +%Y%m%d-%H%M%S)"
fi
base64 -d > "$SCRIPT" <<'PAYLOAD'

PAYLOAD
chmod 755 "$SCRIPT"
python3 - "$SCRIPT" "$LAUNCHER" <<'PYINNER'
import pathlib,sys
script,launcher=sys.argv[1:]
# Freedesktop Exec quoting: paths with spaces must be double quoted.
def quote(p):
    return '"'+p.replace('\\','\\\\').replace('"','\\"').replace('$','\\$').replace('`','\\`')+'"'
text='[Desktop Entry]\nVersion=1.0\nType=Application\nName=Opera GX Codec Fix\nComment=Repair Opera GX video playback\nExec=/bin/bash '+quote(script)+'\nIcon=applications-multimedia\nTerminal=true\nCategories=Utility;AudioVideo;\n'
pathlib.Path(launcher).write_text(text)
PYINNER
chmod 755 "$LAUNCHER"
if command -v gio >/dev/null; then gio set "$LAUNCHER" metadata::trusted true 2>/dev/null || true; fi
printf '\nInstalled!\nRepair script: %s\nDesktop launcher: %s\n\n' "$SCRIPT" "$LAUNCHER"
printf 'On GNOME, right-click the desktop launcher and choose Allow Launching if prompted.\n'
printf 'The fixer will request sudo only when replacing Opera GX codecs.\n'
if [[ -t 0 ]]; then read -r -p 'Press Enter to close...' _ || true; fi
